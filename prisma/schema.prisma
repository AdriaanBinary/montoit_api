// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String    @id @db.VarChar(16)
  username            String    @unique @db.VarChar(100)
  email               String    @unique @db.VarChar(255)
  password            String?   @db.Text
  role                UserRole  @default(PRIVATE)
  subscription        String?   @default("free") @db.VarChar(50)
  subscription_expiry DateTime? @db.Timestamptz(6)
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  updated_at          DateTime  @default(now()) @db.Timestamptz(6)

  listingEnquiriesAsOwner    ListingEnquiry[] @relation("ListingEnquiryListingOwner")
  listingEnquiriesSubmitted   ListingEnquiry[] @relation("ListingEnquirySubmittedByUser")
  favoriteListings            UserFavorite[]

  @@map("users")
}

enum UserRole {
  PRIVATE
  AGENT

  @@map("user_role")
}

model Listing {
  id                 Int               @id @default(autoincrement())
  user_id            String            @db.VarChar(16)
  title              String?           @db.Text
  description        String?           @db.Text
  location           String?           @db.Text
  property_type      String?           @db.VarChar(50)
  listing_type       ListingType       @default(SALE)
  bedrooms           Int?
  bathrooms          Decimal?          @db.Decimal(3, 1)
  property_size      Decimal?          @db.Decimal(8, 2)
  living_area        Decimal?          @db.Decimal(8, 2)
  land_size          Decimal?          @db.Decimal(8, 2)
  amount             Decimal?          @db.Decimal(12, 2)
  furnished          Boolean?
  available_from     DateTime?         @db.Timestamptz(6)
  rental_term        String?           @db.VarChar(50)
  parking_spaces     Int?
  parking_type       String?           @db.VarChar(50)
  pet_friendly       Boolean?          @default(false)
  garden             Boolean?          @default(false)
  pool               Boolean?          @default(false)
  flatlet            Boolean?          @default(false)
  retirement         Boolean?          @default(false)
  on_show            Boolean?          @default(false)
  security_estate    Boolean?          @default(false)
  currency           String            @default("XAF") @db.Char(3)
  features           String[]
  other              String[]
  status             ListingStatus     @default(draft)
  sold               Boolean?          @default(false)
  region_id          Int?
  city_id            Int?
  municipality_id    Int?
  neighborhood_id    Int?
  listing_owner_type ListingOwnerType? @default(PRIVATE)
  agency_id          Int?
  is_published       Boolean           @default(false)
  verified           Boolean           @default(false)
  deleted_at         DateTime?         @db.Timestamptz(6)
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime          @default(now()) @db.Timestamptz(6)

  enquiries          ListingEnquiry[]
  favorites          UserFavorite[]

  @@map("listings")
}

model ListingImage {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listing_id       Int
  object_key       String   @db.Text
  sort_order       Int      @default(0)
  width            Int?
  height           Int?
  upload_confirmed Boolean  @default(false)
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  @@map("listing_images")
}

model ListingEnquiry {
  id                   Int      @id @default(autoincrement())
  listing_id           Int
  listing_owner_user_id String   @db.VarChar(16)
  submitted_by_user_id  String?  @db.VarChar(16)
  name                 String   @db.VarChar(160)
  email                String   @db.VarChar(255)
  phone                String?  @db.VarChar(50)
  message              String   @db.Text
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @db.Timestamptz(6)

  listing Listing @relation(fields: [listing_id], references: [id])
  listingOwner User @relation("ListingEnquiryListingOwner", fields: [listing_owner_user_id], references: [id])
  submittedByUser User? @relation("ListingEnquirySubmittedByUser", fields: [submitted_by_user_id], references: [id])

  @@map("listing_enquiries")
}

model UserFavorite {
  id         Int      @id @default(autoincrement())
  user_id    String   @db.VarChar(16)
  listing_id Int
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id])
  listing Listing @relation(fields: [listing_id], references: [id])

  @@unique([user_id, listing_id], map: "unique_user_favorite_listing")
  @@map("user_favorites")
}

model Agency {
  id                 Int      @id @default(autoincrement())
  name               String   @db.VarChar(160)
  slug               String   @unique @db.VarChar(140)
  description        String?  @db.Text
  email              String?  @db.VarChar(255)
  phone              String?  @db.VarChar(50)
  website            String?  @db.Text
  address_line1      String?  @db.Text
  address_line2      String?  @db.Text
  region_id          Int?
  city_id            Int?
  municipality_id    Int?
  neighborhood_id    Int?
  created_by_user_id String   @db.VarChar(16)
  is_active          Boolean  @default(true)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @db.Timestamptz(6)

  @@map("agencies")
}

model AgencyAgent {
  id         BigInt   @id @default(autoincrement()) @db.BigInt
  agency_id  Int
  user_id    String   @db.VarChar(16)
  is_primary Boolean  @default(false)
  joined_at  DateTime @default(now()) @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @db.Timestamptz(6)

  @@unique([agency_id, user_id], map: "unique_agency_user")
  @@map("agency_agents")
}

enum ListingOwnerType {
  PRIVATE
  AGENT

  @@map("listing_owner_type")
}

enum ListingType {
  SALE
  RENT

  @@map("listing_type")
}

enum ListingStatus {
  draft
  active
  archived
  sold

  @@map("listing_status")
}

model Region {
  id   Int    @id
  name String @unique @db.VarChar(100)

  @@map("regions")
}

model City {
  id        Int    @id
  region_id Int
  name      String @db.VarChar(120)

  @@unique([region_id, name], map: "unique_city_per_region")
  @@map("cities")
}

model Municipality {
  id      Int    @id
  city_id Int
  name    String @db.VarChar(120)

  @@unique([city_id, name], map: "unique_municipality_per_city")
  @@map("municipalities")
}

model Neighborhood {
  id              Int      @id @default(autoincrement())
  municipality_id Int
  name            String   @db.VarChar(160)
  aliases         String[]
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([municipality_id, name], map: "unique_neighborhood_per_municipality")
  @@map("neighborhoods")
}
