# Database Configuration
# Use DATABASE_URL for hosted/production databases.
NODE_ENV=DEV
DATABASE_URL=

# Optional individual database settings for local development.
DB_USER=postgres
DB_HOST=localhost
DB_PASSWORD=change-me
DB_NAME=postgres
DB_PORT=5432

# Server Configuration
PORT=3000
JWT_KEY=replace-with-a-long-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000

# S3-compatible object storage configuration
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_REGION=eu-west-1
AWS_S3_BUCKET=property-images
AWS_S3_ENDPOINT=
# AWS_SESSION_TOKEN=

# Flutterwave Payment Gateway (OAuth 2.0 / newer API)
# Set FLW_USE_SANDBOX=true for test credentials, or false for production.
FLW_USE_SANDBOX=true

# Flutterwave sandbox/test credentials
FLW_SANDBOX_CLIENT_ID=
FLW_SANDBOX_CLIENT_SECRET=
FLW_SANDBOX_ENCRYPTION_KEY=
FLW_SANDBOX_SECRET_HASH=
FLW_SANDBOX_API_BASE_URL=https://developersandbox-api.flutterwave.com

# Flutterwave live credentials
FLW_LIVE_CLIENT_ID=
FLW_LIVE_CLIENT_SECRET=
FLW_LIVE_ENCRYPTION_KEY=
FLW_LIVE_SECRET_HASH=
FLW_LIVE_API_BASE_URL=https://api.flutterwave.com

# Return URL after Flutterwave checkout
FLW_REDIRECT_URL=http://localhost:3000/payment/complete
FLW_PAYMENT_CALLBACK_URL=http://localhost:3000/api/payments/flutterwave/complete
FLW_SUCCESS_REDIRECT_URL=http://localhost:3000/packages

# FLW_*_SECRET_HASH is the webhook signing secret. It is not the OAuth client secret.
# Legacy v3 FLW_*_SECRET_KEY variables are intentionally not used by this integration.
